{
	"author": {
		"email": "hello@adityab.tech",
		"name": "Aditya Borkar",
		"url": "https://adityab.tech"
	},
	"bin": {
		"kiset": "dist/cli.js"
	},
	"bugs": "https://github.com/AdityaBorkar/kiset/issues",
	"dependencies": {
		"arktype": "^2.1.29",
		"commander": "^14.0.3",
		"consola": "^3.4.2",
		"ora": "^9.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@changesets/changelog-github": "^0.5.2",
		"@changesets/cli": "^2.29.8",
		"@octokit/request-error": "^7.1.0",
		"@octokit/rest": "^22.0.1",
		"@opencode-ai/sdk": "^1.2.15",
		"@types/bun": "^1.3.9",
		"husky": "^9.1.7",
		"markdownlint-cli2": "^0.21.0",
		"typescript": "^5.9.3"
	},
	"displayName": "Kiset",
	"engines": {
		"bun": ">=1.0.0",
		"node": ">=22.0.0"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist/**/*",
		"README.md",
		"LICENSE.md",
		"CHANGELOG.md",
		"package.json"
	],
	"homepage": "https://github.com/AdityaBorkar/kiset",
	"imports": {
		"#/*": "./src/*"
	},
	"keywords": ["local dev", "port proxy", "caddy", "infisical", "tunnel"],
	"module": "dist/index.ts",
	"name": "kiset",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AdityaBorkar/kiset.git"
	},
	"scripts": {
		"build": "bun scripts/build.ts",
		"dev": "bun src/cli.ts",
		"lint": "biome check",
		"lint:fix": "biome check --fix",
		"prepare": "husky",
		"typecheck": "tsc --noEmit"
	},
	"sideEffects": false,
	"type": "module",
	"version": "0.1.2"
}
